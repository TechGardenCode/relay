{
  "name": "@techgardencode/relay",
  "version": "0.1.0",
  "description": "Relay — self-hosted server, CLI, and attach client for remote-controlling Claude Code agent sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechGardenCode/relay.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/TechGardenCode/relay#readme",
  "bugs": {
    "url": "https://github.com/TechGardenCode/relay/issues"
  },
  "type": "module",
  "bin": {
    "relay": "./dist/cli/relay.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/store/migrations",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b --force",
    "fix-pty": "node scripts/fix-pty.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "tsc -b --force && node scripts/strip-dist-tests.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@techgardencode/protocol": "workspace:^",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "node-pty": "^1.2.0-beta.14",
    "ulid": "^3.0.2",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.1",
    "@xterm/headless": "^6.0.0",
    "fast-check": "^4.8.0"
  }
}
