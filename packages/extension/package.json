{
  "name": "relay-extension",
  "displayName": "Relay",
  "description": "Spawn and attach to Relay agent sessions from VS Code, Cursor, and VSCodium.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "publisher": "relay",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "relay.connectServer",
        "title": "Relay: Connect to server"
      },
      {
        "command": "relay.startSession",
        "title": "Relay: Start session in current project"
      },
      {
        "command": "relay.attachSession",
        "title": "Relay: Attach to session"
      },
      {
        "command": "relay.registerWorkspace",
        "title": "Relay: Register this workspace as a project"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "build": "node esbuild.config.mjs",
    "vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@relay/protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  }
}
